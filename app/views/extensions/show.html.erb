<% content_for :body_class, "login" %>
<% content_for :javascript_entry, "copy" %>
<div class="extension-page">
  <%= link_to planner_path, class: "page-back" do %><%= icon("arrow-left") %>Planner<% end %>
  <div class="login-card extension-card">
    <span class="login-brand">Browser extension · v<%= @version %></span>
    <h1>MCC Filler</h1>
    <p class="muted">Makes the MCC choice-filling list match your planner in one click, or brings MCC's list into the planner. You sign in to MCC yourself, save with the OTP yourself, and it never locks.</p>
    <div class="computer-needed touch-only">
      <p><%= icon("laptop") %><span><strong>Needs Chrome on a laptop or desktop.</strong> Phones and tablets can't run Chrome extensions. Send this page to yourself and open it on your computer.</span></p>
      <div class="share-link link-copy">
        <input type="text" readonly value="<%= extension_url %>" aria-label="Link to this page">
        <%= tag.button "Copy", type: "button", class: "primary share-copy", data: click_event("extension-page/copy-link") %>
      </div>
      <p class="share-status" role="status"></p>
      <div class="extension-actions">
        <%= link_to extension_link_whatsapp_url, class: "button block", target: "_blank", rel: "noopener", data: click_event("extension-page/whatsapp-link") do %><%= icon("message-circle") %>WhatsApp<% end %>
        <%= link_to extension_link_email_url, class: "button block", data: click_event("extension-page/email-link") do %><%= icon("mail") %>Email<% end %>
      </div>
      <p class="muted store-anyway">Already on a computer? <%= link_to "Open it in the Chrome Web Store", ExtensionPackage::CHROME_WEB_STORE_URL, target: "_blank", rel: "noopener", data: click_event("extension-page/store-anyway") %></p>
    </div>
    <div class="store-badges no-touch">
      <% if @firefox && ExtensionPackage::FIREFOX_LISTED %>
        <%= link_to ExtensionPackage::FIREFOX_ADD_ONS_URL, class: "store-badge", target: "_blank", rel: "noopener", data: click_event("extension-page/firefox-add-ons") do %><%= image_tag "store-badges/firefox-add-ons.svg", alt: "Get the add-on for Firefox", height: 60 %><% end %>
      <% else %>
        <% if @firefox %>
          <p class="store-note">The Firefox version is in Mozilla's review and will be here soon. Until then, install it in Chrome, Edge or Brave.</p>
        <% end %>
        <%= link_to ExtensionPackage::CHROME_WEB_STORE_URL, class: "store-badge", target: "_blank", rel: "noopener", data: click_event("extension-page/chrome-web-store") do %><%= image_tag "store-badges/chrome-web-store.png", alt: "Available in the Chrome Web Store", height: 60 %><% end %>
      <% end %>
    </div>
    <p class="touch-only install-lead">Then, on your computer:</p>
    <ol class="install-steps">
      <% if @firefox && ExtensionPackage::FIREFOX_LISTED %>
        <li>Press <strong>Get the add-on</strong>, then <strong>Add to Firefox</strong> and <strong>Add</strong>.</li>
      <% else %>
        <li>Press <strong>Available in the Chrome Web Store</strong>, then <strong>Add to Chrome</strong> in the store.</li>
      <% end %>
      <li>Reload the planner. Your plan now syncs to the extension by itself.</li>
      <li>Sign in to MCC and open Choice Filling. The panel in the bottom-right corner shows <em>In sync</em> or the differences, with <strong>Plan → MCC</strong> and <strong>MCC → Plan</strong> whenever they differ. Each makes one side an exact copy of the other.</li>
    </ol>
    <section class="manual-install no-touch">
      <h2>Install by hand</h2>
      <p class="muted">For Chrome without the store, or to read the code. A hand-installed copy doesn't update itself.</p>
      <div class="extension-actions">
        <%= link_to download_extension_path, class: "button block", data: click_event("extension-page/download") do %><%= icon("download") %>Download<% end %>
        <%= link_to "https://github.com/fazzledev/neet-pg-choice-planner/tree/main/extension", class: "button block", target: "_blank", rel: "noopener", data: click_event("extension-page/source") do %><%= icon("github") %>Source<% end %>
      </div>
      <details>
        <summary>How to install the download</summary>
        <ol class="install-steps">
          <li>Unzip the download into a folder. <code>manifest.json</code> sits directly inside it.</li>
          <li>Open <code>chrome://extensions</code> <button type="button" class="button-link copy-btn" data-copy="chrome://extensions" aria-label="Copy chrome://extensions" title="Copy"><%= icon("copy") %><%= icon("check") %></button> in a new tab and turn on <strong>Developer mode</strong>.</li>
          <li>Press <strong>Load unpacked</strong> and pick that folder. Download it again for new versions.</li>
        </ol>
      </details>
    </section>
    <p class="muted">Want to try it before your MCC session? The <%= link_to "practice page", practice_path %> works like MCC's choice filling with this year's choices, and the extension runs there too.</p>
  </div>
</div>
<%= javascript_include_tag "link_copy", defer: true %>
