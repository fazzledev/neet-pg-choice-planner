<% prefix = local_assigns.fetch(:id_prefix, "group") %>
<div class="ext-groups<%= " two-groups" if ExtensionPackage.firefox_listed %><%= " compact" if local_assigns[:compact] %>">
  <section class="ext-group ext-group-now" aria-labelledby="<%= prefix %>-now">
    <h3 id="<%= prefix %>-now"><%= icon("check") %>Available now</h3>
    <ul>
      <% [["chrome", "Chrome"], ["edge", "Edge"], ["brave", "Brave"], ["opera", "Opera"], *(ExtensionPackage.firefox_listed ? [["firefox", "Firefox"]] : [])].each do |logo, name| %>
        <li><%= image_tag "browsers/#{logo}.svg", alt: "", width: 28, height: 28 %><span><strong><%= name %></strong></span></li>
      <% end %>
    </ul>
  </section>
  <% unless ExtensionPackage.firefox_listed %>
    <section class="ext-group ext-group-soon" aria-labelledby="<%= prefix %>-soon">
      <h3 id="<%= prefix %>-soon"><%= icon("history") %>Coming soon</h3>
      <ul>
        <li><%= image_tag "browsers/firefox.svg", alt: "", width: 28, height: 28 %><span><strong>Firefox</strong>Computer and Android</span></li>
      </ul>
    </section>
  <% end %>
  <section class="ext-group ext-group-no" aria-labelledby="<%= prefix %>-no">
    <h3 id="<%= prefix %>-no"><%= icon("x") %>Not supported</h3>
    <ul>
      <li><%= image_tag "browsers/safari.svg", alt: "", width: 28, height: 28 %><span><strong>Safari</strong>Mac and iPhone</span></li>
      <li><%= image_tag "browsers/chrome.svg", alt: "", width: 28, height: 28 %><span><strong>Chrome on phones</strong>Android and iPhone</span></li>
    </ul>
  </section>
</div>
