<% content_for :body_class, "login" %>
<%= form_with url: session_path, class: "login-card" do |f| %>
  <span class="login-brand">NEET PG 2026</span>
  <h1>NEET PG Choice Planner</h1>
  <% if params[:sent] %>
    <p>Check your email. If that address can sign in, a link is on its way. It works once and expires in <%= User::SIGN_IN_LINK_TTL.inspect %>.</p>
    <p><%= link_to "Back to the planner", planner_path %></p>
  <% else %>
    <p class="muted">Sign in to sync your plan across devices. You can also keep using the planner without an account; it saves on this device.</p>
    <%= f.label :email, "Email" %>
    <%= f.email_field :email, autocomplete: "email", autofocus: true, required: true %>
    <button type="submit" class="primary">Email me a sign-in link</button>
    <p class="muted">We keep your email and plan only to sync it. <%= link_to "Privacy", privacy_path %></p>
    <p><%= link_to "Continue without signing in", planner_path %></p>
  <% end %>
<% end %>
