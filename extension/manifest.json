{
  "manifest_version": 3,
  "name": "NEET PG Choice Planner – MCC Filler",
  "version": "1.3.1",
  "description": "Copy your NEET PG Choice Planner list to MCC choice filling in one click, or import it back. Never locks. Not affiliated with MCC.",
  "homepage_url": "https://github.com/fazzledev/neet-pg-choice-planner/tree/main/extension",
  "icons": { "16": "icons/icon-16.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png" },
  "browser_specific_settings": {
    "gecko": {
      "id": "mcc-filler@neet-pg-choice-planner.fazzle.dev",
      "strict_min_version": "140.0",
      "data_collection_permissions": { "required": ["websiteContent"] }
    },
    "gecko_android": { "strict_min_version": "142.0" }
  },
  "permissions": ["storage"],
  "content_scripts": [
    {
      "matches": ["https://neet-pg-choice-planner.fazzle.dev/*"],
      "exclude_matches": ["https://neet-pg-choice-planner.fazzle.dev/practice", "https://neet-pg-choice-planner.fazzle.dev/practice?*"],
      "js": ["planner-bridge.js"],
      "run_at": "document_start"
    },
    {
      "matches": ["https://mcc.admissions.nic.in/*", "https://neet-pg-choice-planner.fazzle.dev/practice", "https://neet-pg-choice-planner.fazzle.dev/practice?*"],
      "js": ["portal-adapter.js", "portal.js"],
      "run_at": "document_idle"
    }
  ]
}
