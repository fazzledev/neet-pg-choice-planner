{
  "manifest_version": 3,
  "name": "NEET PG Choice Planner filler",
  "version": "0.7.1",
  "description": "Makes the MCC choice-filling list match your NEET PG Choice Planner order, or imports it back. Never locks.",
  "permissions": ["storage"],
  "content_scripts": [
    {
      "matches": ["https://neet-pg-choice-planner.fazzle.dev/*", "https://neet-pg-choices.fazzle.dev/*", "https://mcc.fazzle.dev/*"],
      "js": ["planner-bridge.js"],
      "run_at": "document_start"
    },
    {
      "matches": ["https://mcc.admissions.nic.in/*"],
      "js": ["portal-adapter.js", "portal.js"],
      "run_at": "document_idle"
    }
  ]
}
