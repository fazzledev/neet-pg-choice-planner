<title>Institute Location Review</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Public+Sans:wght@400;600;700&family=JetBrains+Mono:wght@500&display=swap">
<style>
:root {
  --bg: #f5f6f8; --surface: #ffffff; --ink: #1b2130; --muted: #596173; --line: #dce0e7;
  --accent: #1d6a86; --accent-soft: #e3f0f5;
  --move: #b3261e; --move-soft: #fbe9e7;
  --relabel: #4f5768; --relabel-soft: #eceef2;
  --unsure: #8a5a00; --unsure-soft: #fdf1d6;
  --old: #8a91a0;
}
@media (prefers-color-scheme: dark) {
  :root:not([data-theme="light"]) {
    color-scheme: dark;
    --bg: #0f131b; --surface: #171c27; --ink: #e8ebf2; --muted: #a2a9b8; --line: #2b3242;
    --accent: #6fbad6; --accent-soft: #19323d;
    --move: #ff9b8f; --move-soft: #3a1c1a;
    --relabel: #b3bac8; --relabel-soft: #232a37;
    --unsure: #f1c56b; --unsure-soft: #352a12;
    --old: #7d8596;
  }
}
:root[data-theme="dark"] {
  color-scheme: dark;
  --bg: #0f131b; --surface: #171c27; --ink: #e8ebf2; --muted: #a2a9b8; --line: #2b3242;
  --accent: #6fbad6; --accent-soft: #19323d;
  --move: #ff9b8f; --move-soft: #3a1c1a;
  --relabel: #b3bac8; --relabel-soft: #232a37;
  --unsure: #f1c56b; --unsure-soft: #352a12;
  --old: #7d8596;
}
body { background: var(--bg); color: var(--ink); font: 15px/1.5 "Public Sans", system-ui, sans-serif; padding-inline: 16px; }
.wrap { max-width: 1240px; margin: 0 auto; padding-block: 32px 48px; display: flex; flex-direction: column; gap: 20px; }
h1 { margin: 0; font-size: 28px; font-weight: 700; text-wrap: balance; }
.lede { margin: 0; max-width: 68ch; color: var(--muted); }
.tabs { display: flex; flex-wrap: wrap; gap: 8px; }
.tab { display: flex; flex-direction: column; align-items: flex-start; gap: 2px; min-width: 132px; padding: 10px 14px; border: 1px solid var(--line); border-radius: 10px; background: var(--surface); color: var(--ink); font: inherit; text-align: left; cursor: pointer; }
.tab b { font-size: 22px; font-variant-numeric: tabular-nums; }
.tab span { font-size: 13px; color: var(--muted); }
.tab[aria-pressed="true"] { border-color: var(--accent); box-shadow: inset 0 0 0 1px var(--accent); background: var(--accent-soft); }
.tab:focus-visible, .search:focus-visible { outline: 2px solid var(--accent); outline-offset: 2px; }
.bar { display: flex; flex-wrap: wrap; align-items: center; gap: 12px; }
.search { flex: 1 1 260px; min-height: 40px; padding: 0 12px; border: 1px solid var(--line); border-radius: 8px; background: var(--surface); color: var(--ink); font: inherit; }
.count { color: var(--muted); font-size: 13px; font-variant-numeric: tabular-nums; }
.table-box { overflow-x: auto; border: 1px solid var(--line); border-radius: 10px; background: var(--surface); }
table { width: 100%; min-width: 920px; border-collapse: collapse; }
th, td { padding: 10px 12px; border-bottom: 1px solid var(--line); text-align: left; vertical-align: top; }
th { position: sticky; top: 0; background: var(--surface); font-size: 12px; font-weight: 600; letter-spacing: .04em; text-transform: uppercase; color: var(--muted); }
tr:last-child td { border-bottom: 0; }
.code { font: 500 12px "JetBrains Mono", ui-monospace, monospace; color: var(--muted); }
.official { display: block; margin-top: 2px; font-size: 12px; color: var(--muted); }
.was { display: block; color: var(--old); text-decoration: line-through; text-decoration-thickness: 1px; font-size: 13px; }
.now { display: block; font-weight: 600; }
.same { color: var(--muted); }
.chip { display: inline-block; padding: 1px 8px; border-radius: 999px; font-size: 12px; font-weight: 600; white-space: nowrap; }
.chip.move { color: var(--move); background: var(--move-soft); }
.chip.relabel { color: var(--relabel); background: var(--relabel-soft); }
.chip.medium, .chip.low { color: var(--unsure); background: var(--unsure-soft); }
.evidence { max-width: 34ch; font-size: 13px; color: var(--muted); }
.place { font-size: 12px; color: var(--muted); }
.more { align-self: center; min-height: 40px; padding: 0 18px; border: 1px solid var(--line); border-radius: 8px; background: var(--surface); color: var(--ink); font: inherit; cursor: pointer; }
@media (prefers-reduced-motion: no-preference) { .tab { transition: background .15s, border-color .15s; } }
</style>

<div class="wrap">
  <header style="display:flex;flex-direction:column;gap:8px">
    <h1>Institute location review</h1>
    <p class="lede">Every one of the <%= summary[:institutes] %> MCC institutes was checked twice, from its official name, address and pincode, with web lookups where those didn't settle it. Card titles don't change. A map pin moves only when its current place isn't in MCC's own record for the institute; every other pin keeps its name. All of Delhi is one pin. Nothing here is live yet.</p>
  </header>

  <div class="tabs" role="group" aria-label="Show">
    <button class="tab" type="button" data-filter="move" aria-pressed="true"><b><%= summary[:moved] %></b><span>Pins that move to another place</span></button>
    <button class="tab" type="button" data-filter="relabel" aria-pressed="false"><b><%= summary[:relabelled] %></b><span>Pins renamed, same place</span></button>
    <button class="tab" type="button" data-filter="unsure" aria-pressed="false"><b><%= summary[:uncertain] %></b><span>Reviewer not fully sure</span></button>
    <button class="tab" type="button" data-filter="all" aria-pressed="false"><b><%= summary[:institutes] %></b><span>All institutes</span></button>
  </div>

  <div class="bar">
    <label for="q" class="count" style="font-size:14px">Search</label>
    <input id="q" class="search" type="search" placeholder="Institute, town, state or code" autocomplete="off">
    <span class="count" id="count" aria-live="polite"></span>
  </div>

  <div class="table-box">
    <table>
      <thead><tr><th>Institute</th><th>Card title (unchanged)</th><th>Map pin</th><th>Confidence</th><th>Evidence</th></tr></thead>
      <tbody id="rows"></tbody>
    </table>
  </div>
  <button class="more" id="more" type="button" hidden>Show more</button>
</div>

<script>
const ROWS = <%= rows %>;
const PAGE = 200;
let filter = "move";
let shown = PAGE;
const esc = (s) => String(s ?? "").replace(/[&<>"]/g, (c) => ({ "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;" })[c]);
const matches = {
  move: (r) => r.pin_change === "move",
  relabel: (r) => r.pin_change === "relabel",
  unsure: (r) => r.confidence !== "high",
  all: () => true,
};
const pair = (was, now, changed) => changed
  ? `<span class="was">${esc(was) || "none"}</span><span class="now">${esc(now)}</span>`
  : `<span class="same">${esc(now)}</span>`;
function render() {
  const q = document.getElementById("q").value.trim().toLowerCase();
  const list = ROWS.filter(matches[filter]).filter((r) => !q || [r.code, r.name, r.title, r.pin, r.pin_was, r.state, r.district].join(" ").toLowerCase().includes(q));
  const html = list.slice(0, shown).map((r) => `<tr>
    <td><span class="code">${esc(r.code)}</span><span class="official">${esc(r.name)}</span></td>
    <td><span class="same">${esc(r.title)}</span></td>
    <td>${pair(r.pin_was, r.pin, r.pin_change !== "same")}${r.pin_change !== "same" ? ` <span class="chip ${r.pin_change}">${r.pin_change === "move" ? "moves" : "renamed"}</span>` : ""}<span class="place">${esc(r.district)}, ${esc(r.state)}</span></td>
    <td>${r.confidence === "high" ? '<span class="same">High</span>' : `<span class="chip ${esc(r.confidence)}">${r.confidence === "medium" ? "Medium" : "Low"}</span>`}</td>
    <td class="evidence">${esc(r.evidence)}</td>
  </tr>`).join("");
  document.getElementById("rows").innerHTML = html || '<tr><td colspan="5" class="same">No institutes match.</td></tr>';
  document.getElementById("count").textContent = `Showing ${Math.min(shown, list.length)} of ${list.length}`;
  document.getElementById("more").hidden = shown >= list.length;
}
document.querySelectorAll(".tab").forEach((tab) => tab.addEventListener("click", () => {
  filter = tab.dataset.filter;
  shown = PAGE;
  document.querySelectorAll(".tab").forEach((t) => t.setAttribute("aria-pressed", String(t === tab)));
  render();
}));
document.getElementById("q").addEventListener("input", () => { shown = PAGE; render(); });
document.getElementById("more").addEventListener("click", () => { shown += PAGE; render(); });
render();
</script>
